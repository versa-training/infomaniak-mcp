# Users connect with their own Infomaniak API token as the bearer token.
# It needs user_info (identity check) plus the product scopes:
# workspace:mail mail workspace:calendar kmeet workspace:contact drive kchat user_email
ALLOWED_EMAIL_DOMAINS=example.com   # your domain, comma-separated; other accounts get 403
# Optional shared token for a service account (needs INFOMANIAK_TOKEN)
MCP_BEARER_TOKEN=            # at least 32 characters
INFOMANIAK_TOKEN=
# Listener
PORT=8787
HOST=127.0.0.1
# kDrive (skipped when KDRIVE_ID is empty)
KDRIVE_ID=
KDRIVE_ALLOW_PUBLIC_LINKS=false
# kChat (skipped when KCHAT_TEAM_NAME is empty)
KCHAT_TEAM_NAME=
# Mail
MAIL_ALLOW_SEND=false
MAIL_ALLOW_PERMANENT_DELETE=false
