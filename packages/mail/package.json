{
  "name": "@infomaniak/mcp-server-mail",
  "version": "2.1.0",
  "description": "MCP server for interacting with Infomaniak Mail via web API",
  "license": "MIT",
  "author": "Infomaniak (https://infomaniak.com)",
  "homepage": "https://infomaniak.com",
  "bugs": "https://github.com/infomaniak/mcp-server-mail/issues",
  "type": "module",
  "bin": {
    "mcp-server-mail": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "test": "npm run build && node --test tests/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.32",
    "zod": "^4"
  }
}
