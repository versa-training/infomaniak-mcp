{
  "name": "@infomaniak/mcp-server-contact",
  "version": "1.0.2",
  "description": "MCP server for interacting with Infomaniak Contacts via web API",
  "license": "MIT",
  "author": "Infomaniak (https://infomaniak.com)",
  "homepage": "https://infomaniak.com",
  "bugs": "https://github.com/infomaniak/mcp-server-contact/issues",
  "type": "module",
  "bin": {
    "mcp-server-contact": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && node -e \"for (const f of require('fs').readdirSync('dist')) if (f.endsWith('.js')) require('fs').chmodSync('dist/' + f, 0o755)\"",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "test": "npm run build && node --test tests/*.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.32",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^7.0.2"
  }
}
